{
  "name": "faisceau-ui",
  "version": "0.4.3",
  "description": "Accessible vanilla DOM components powered by Faisceau and Zag.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilian1315/faisceau-ui.git"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./checkbox": "./dist/checkbox/index.mjs",
    "./collapsible": "./dist/collapsible/index.mjs",
    "./combobox": "./dist/combobox/index.mjs",
    "./dialog": "./dist/dialog/index.mjs",
    "./drawer": "./dist/drawer/index.mjs",
    "./select": "./dist/select/index.mjs",
    "./toast": "./dist/toast/index.mjs",
    "./tooltip": "./dist/tooltip/index.mjs",
    "./package.json": "./package.json",
    "./styles/index.css": {
      "types": "./dist/styles/index.css.d.ts",
      "default": "./dist/styles/index.css"
    },
    "./styles/index.scss": "./src/styles/index.scss",
    "./styles/checkbox.css": {
      "types": "./dist/styles/checkbox.css.d.ts",
      "default": "./dist/styles/checkbox.css"
    },
    "./styles/checkbox.scss": "./src/styles/checkbox.scss",
    "./styles/collapsible.css": {
      "types": "./dist/styles/collapsible.css.d.ts",
      "default": "./dist/styles/collapsible.css"
    },
    "./styles/collapsible.scss": "./src/styles/collapsible.scss",
    "./styles/combobox.css": {
      "types": "./dist/styles/combobox.css.d.ts",
      "default": "./dist/styles/combobox.css"
    },
    "./styles/combobox.scss": "./src/styles/combobox.scss",
    "./styles/dialog.css": {
      "types": "./dist/styles/dialog.css.d.ts",
      "default": "./dist/styles/dialog.css"
    },
    "./styles/dialog.scss": "./src/styles/dialog.scss",
    "./styles/drawer.css": {
      "types": "./dist/styles/drawer.css.d.ts",
      "default": "./dist/styles/drawer.css"
    },
    "./styles/drawer.scss": "./src/styles/drawer.scss",
    "./styles/select.css": {
      "types": "./dist/styles/select.css.d.ts",
      "default": "./dist/styles/select.css"
    },
    "./styles/select.scss": "./src/styles/select.scss",
    "./styles/toast.css": {
      "types": "./dist/styles/toast.css.d.ts",
      "default": "./dist/styles/toast.css"
    },
    "./styles/toast.scss": "./src/styles/toast.scss",
    "./styles/tokens.css": {
      "types": "./dist/styles/tokens.css.d.ts",
      "default": "./dist/styles/tokens.css"
    },
    "./styles/tokens.scss": "./src/styles/tokens.scss",
    "./styles/tooltip.css": {
      "types": "./dist/styles/tooltip.css.d.ts",
      "default": "./dist/styles/tooltip.css"
    },
    "./styles/tooltip.scss": "./src/styles/tooltip.scss"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:styles": "sass src/styles:dist/styles --no-source-map --style=expanded && node scripts/build-css-dts.mjs",
    "build": "vpr build:styles && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@lilian1315/create-element": "catalog:",
    "@lucide/icons": "catalog:",
    "@zag-js/checkbox": "catalog:",
    "@zag-js/collapsible": "catalog:",
    "@zag-js/combobox": "catalog:",
    "@zag-js/dialog": "catalog:",
    "@zag-js/dom-query": "catalog:",
    "@zag-js/drawer": "catalog:",
    "@zag-js/select": "catalog:",
    "@zag-js/toast": "catalog:",
    "@zag-js/tooltip": "catalog:",
    "faisceau": "catalog:",
    "faisceau-zag": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "jsr-exports-lint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "sass-embedded": "catalog:",
    "vitest": "catalog:"
  }
}
