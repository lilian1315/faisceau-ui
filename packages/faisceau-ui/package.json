{
  "name": "faisceau-ui",
  "version": "0.0.1",
  "description": "Accessible vanilla DOM components powered by Faisceau and Zag.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilian1315/faisceau-ui.git"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./checkbox": "./dist/checkbox/index.mjs",
    "./combobox": "./dist/combobox/index.mjs",
    "./dialog": "./dist/dialog/index.mjs",
    "./drawer": "./dist/drawer/index.mjs",
    "./field": "./dist/field/index.mjs",
    "./select": "./dist/select/index.mjs",
    "./toast": "./dist/toast/index.mjs",
    "./tooltip": "./dist/tooltip/index.mjs",
    "./package.json": "./package.json",
    "./styles/index.css": "./src/styles/index.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@lilian1315/create-element": "catalog:",
    "@lucide/icons": "catalog:",
    "@zag-js/checkbox": "catalog:",
    "@zag-js/combobox": "catalog:",
    "@zag-js/dialog": "catalog:",
    "@zag-js/drawer": "catalog:",
    "@zag-js/select": "catalog:",
    "@zag-js/toast": "catalog:",
    "@zag-js/tooltip": "catalog:",
    "faisceau": "catalog:",
    "faisceau-zag": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "jsr-exports-lint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "vitest": "catalog:"
  }
}
