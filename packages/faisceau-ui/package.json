{
  "name": "faisceau-ui",
  "version": "0.5.0",
  "description": "Accessible vanilla DOM components powered by Faisceau and Zag.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilian1315/faisceau-ui.git"
  },
  "files": [
    "dist",
    "src/icons",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./checkbox": "./dist/checkbox/index.js",
    "./collapsible": "./dist/collapsible/index.js",
    "./combobox": "./dist/combobox/index.js",
    "./dialog": "./dist/dialog/index.js",
    "./drawer": "./dist/drawer/index.js",
    "./select": "./dist/select/index.js",
    "./toast": "./dist/toast/index.js",
    "./tooltip": "./dist/tooltip/index.js",
    "./package.json": "./package.json",
    "./styles/base.css": "./dist/styles/base.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:styles": "sass src/styles:dist/styles --no-source-map --style=expanded && rm -rf dist/icons && cp -r src/icons dist/icons && node scripts/build-css-dts.mjs",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@lilian1315/create-element": "catalog:",
    "@zag-js/checkbox": "catalog:",
    "@zag-js/collapsible": "catalog:",
    "@zag-js/combobox": "catalog:",
    "@zag-js/dialog": "catalog:",
    "@zag-js/dom-query": "catalog:",
    "@zag-js/drawer": "catalog:",
    "@zag-js/select": "catalog:",
    "@zag-js/toast": "catalog:",
    "@zag-js/tooltip": "catalog:",
    "faisceau": "catalog:",
    "faisceau-zag": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "sass-embedded": "catalog:",
    "vitest": "catalog:"
  }
}
