{
  "name": "@lilian1315/faisceau-ui",
  "version": "0.0.0",
  "description": "Accessible vanilla DOM components powered by Faisceau and Zag.js.",
  "license": "MIT",
  "files": [
    "dist",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./select": {
      "types": "./dist/select/index.d.mts",
      "import": "./dist/select/index.mjs"
    },
    "./field": {
      "types": "./dist/field/index.d.mts",
      "import": "./dist/field/index.mjs"
    },
    "./combobox": {
      "types": "./dist/combobox/index.d.mts",
      "import": "./dist/combobox/index.mjs"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.mts",
      "import": "./dist/checkbox/index.mjs"
    },
    "./tooltip": {
      "types": "./dist/tooltip/index.d.mts",
      "import": "./dist/tooltip/index.mjs"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.mts",
      "import": "./dist/dialog/index.mjs"
    },
    "./drawer": {
      "types": "./dist/drawer/index.d.mts",
      "import": "./dist/drawer/index.mjs"
    },
    "./toast": {
      "types": "./dist/toast/index.d.mts",
      "import": "./dist/toast/index.mjs"
    },
    "./styles.css": {
      "types": "./src/styles/index.d.ts",
      "default": "./src/styles/index.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "@lilian1315/create-element": "catalog:",
    "@lilian1315/faisceau-zag": "workspace:*",
    "@lucide/icons": "catalog:",
    "@zag-js/checkbox": "catalog:",
    "@zag-js/combobox": "catalog:",
    "@zag-js/dialog": "catalog:",
    "@zag-js/drawer": "catalog:",
    "@zag-js/select": "catalog:",
    "@zag-js/toast": "catalog:",
    "@zag-js/tooltip": "catalog:",
    "faisceau": "catalog:"
  }
}
